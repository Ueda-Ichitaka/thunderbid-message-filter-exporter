{
  "manifest_version": 3,
  "name": "Message Filter Exporter",
  "description": "Export and import Thunderbird message filters per mail account.",
  "version": "0.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "message-filter-exporter@richard.rudolph",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "filterTools": {
      "schema": "experiments/filterTools/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["filterTools"]],
        "script": "experiments/filterTools/implementation.js"
      }
    }
  }
}
